@Api.Conhecimento_HostAddress = http://localhost:5200

GET {{Api.Conhecimento_HostAddress}}/health
Accept: application/json

###

POST {{Api.Conhecimento_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-03-26",
    "capabilities": {},
    "clientInfo": {
      "name": "validacao-etapa-2",
      "version": "1.0"
    }
  }
}

###

POST {{Api.Conhecimento_HostAddress}}/api/v1/ingest
Accept: application/json
Content-Type: multipart/form-data; boundary=----ingest

------ingest
Content-Disposition: form-data; name="usuario"

infis
------ingest
Content-Disposition: form-data; name="codigoDocumento"

DOC-001
------ingest
Content-Disposition: form-data; name="validade"

2027-12-31
------ingest
Content-Disposition: form-data; name="arquivo"; filename="documento.pdf"
Content-Type: application/pdf

< ./documento.pdf
------ingest--

